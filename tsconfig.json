{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/core/*": ["./packages/core/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "packages/core/src/**/*", "wxt.config.ts", ".wxt/wxt.d.ts"]
}
